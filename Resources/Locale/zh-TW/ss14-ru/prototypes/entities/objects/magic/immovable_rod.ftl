ent-ImmovableRod = 不可移動的桿 | immovable rod
    .desc = 你能感覺到它餓了。這通常是個不祥的徵兆。 | You can sense that it's hungry. That's usually a bad sign.
ent-ImmovableRodDespawn = { ent-ImmovableRod }
    .desc = { ent-ImmovableRod.desc }
    .suffix = Despawn
ent-ImmovableRodSlow = { ent-ImmovableRodDespawn }
    .desc = { ent-ImmovableRodDespawn.desc }
    .suffix = Slow
ent-ImmovableRodKeepTiles = { ent-ImmovableRodDespawn }
    .desc = { ent-ImmovableRodDespawn.desc }
    .suffix = Keep Tiles
ent-ImmovableRodWizard = { ent-ImmovableRod }
    .desc = { ent-ImmovableRod.desc }
    .suffix = Wizard
ent-ImmovableRodKeepTilesStill = { ent-ImmovableRodKeepTiles }
    .desc = { ent-ImmovableRodKeepTiles.desc }
    .suffix = Keep Tiles, Still
ent-ImmovableRodMop = 動彈不得的拖把 | immovable mop
    .desc = 像標槍般被猛力投擲出去，蘊含著一千名憤怒清潔工的勁力。 | Hurled like a javelin, with the power of a thousand furious janitors.
    .suffix = { ent-ImmovableRodKeepTilesStill.suffix }
ent-ImmovableRodShark = 動彈不得的鯊魚 | immovable shark
    .desc = 鯊魚龍捲風！ | SHARK TORNADO!
    .suffix = { ent-ImmovableRodKeepTilesStill.suffix }
ent-ImmovableRodClown = 一動不动的丑角 | immovable clown
    .desc = 從隔壁太陽系的一個鄰近站點被驅逐出來。嗶——！ | Ejected from the neighbouring station one solar system over. HONK!
    .suffix = { ent-ImmovableRodKeepTilesStill.suffix }
ent-ImmovableRodBanana = 動彈不得的香蕉 | immovable banana
    .desc = 至少你不會在上面滑倒。 | At least you won't slip on it.
    .suffix = { ent-ImmovableRodKeepTilesStill.suffix }
ent-ImmovableRodHammer = 堅不可摧的錘子 | immovable hammer
    .desc = 噗嗶。 | Bwoink.
    .suffix = { ent-ImmovableRodKeepTilesStill.suffix }
ent-ImmovableRodThrongler = 堅不可摧的擁擠者 | immovable throngler
    .desc = 只要你抓到了，就能留著。 | If you catch it, you can keep it.
    .suffix = { ent-ImmovableRodKeepTilesStill.suffix }
ent-ImmovableRodGibstick = 不可移動的支撐桿 | immovable gibstick
    .desc = 你原本期待什麼呢？ | What did you expect?
    .suffix = { ent-ImmovableRodKeepTilesStill.suffix }
ent-ImmovableRodWeh = 不可動的 weh | immovable weh
    .desc = 哇！ | WEH!
    .suffix = { ent-ImmovableRodKeepTilesStill.suffix }
