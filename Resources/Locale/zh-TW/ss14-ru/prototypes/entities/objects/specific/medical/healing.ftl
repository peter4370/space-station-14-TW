ent-Ointment = 藥膏 | ointment
    .desc = 用於治療那些嚴重的燒傷。對苛性燒傷的療效較低。 | Used to treat those nasty burns. Less effective on caustic burns.
    .suffix = Full
ent-Ointment1 = { ent-Ointment }
    .desc = { ent-Ointment.desc }
    .suffix = Single
ent-RegenerativeMesh = 再生網格 | regenerative mesh
    .desc = 用於治療即使是最嚴重的燒傷。對腐蝕性燒傷也同樣有效。 | Used to treat even the nastiest burns. Also effective against caustic burns.
    .suffix = Full
ent-OintmentAdvanced1 = { ent-RegenerativeMesh }
    .desc = { ent-RegenerativeMesh.desc }
    .suffix = Single
ent-Brutepack = 外傷敷料包 bruise pack | bruise pack
    .desc = 一款專為治療鈍性創傷而設計的治療用凝膠包及繃帶。 | A therapeutic gel pack and bandages designed to treat blunt-force trauma.
    .suffix = Full
ent-Brutepack1 = { ent-Brutepack }
    .desc = { ent-Brutepack.desc }
    .suffix = Single
ent-MedicatedSuture = 藥用縫合線 | medicated suture
    .desc = 浸泡過藥液的縫合線，能有效治療鈍性創傷並縫合傷口。 | A suture soaked in medicine, treats blunt-force trauma effectively and closes wounds.
    .suffix = Full
ent-BrutepackAdvanced1 = { ent-MedicatedSuture }
    .desc = { ent-MedicatedSuture.desc }
    .suffix = Single
ent-Bloodpack = 血袋 | blood pack
    .desc = 內含由 Nanotrasen 先進醫療科技所研發的、具有突破性的通用型血液替代品。 | Contains a groundbreaking universal blood replacement created by Nanotrasen's advanced medical science.
    .suffix = Full
ent-Bloodpack1 = { ent-Bloodpack }
    .desc = { ent-Bloodpack.desc }
    .suffix = Single
ent-Tourniquet = 止血帶 | tourniquet
    .desc = 止血！希望如此。 | Stops bleeding! Hopefully.
ent-Gauze = 一捲紗布 | roll of gauze
    .desc = 一些無菌紗布，用來包紮流血的殘肢。 | Some sterile gauze to wrap around bloody stumps.
    .suffix = Full
ent-Gauze1 = { ent-Gauze }
