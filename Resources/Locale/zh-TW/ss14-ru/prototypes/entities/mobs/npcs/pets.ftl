ent-MobHamsterHamlet = 哈姆雷特 | Hamlet
    .desc = 一隻愛發牢騷、可愛又毛茸茸的倉鼠。 | A grumpy, cute and fluffy hamster.
    .suffix = { ent-MobHamster.suffix }
ent-MobHamsterHamletSlippery = { ent-MobHamsterHamlet }
