ent-MobCatRuntime = 執行時間 | Runtime
    .desc = 專業捕鼠人。逃脫高手。 | Professional mouse hunter. Escape artist.
    .suffix = { ent-MobCat.suffix }
ent-MobCatException = 例外情況 | Exception
    .desc = 禮貌地開口請求，說不定他們會把其中一條多餘的生命讓給你。 | Ask nicely, and maybe they'll give you one of their spare lives.
    .suffix = { ent-MobCatCalico.suffix }
ent-MobCatFloppa = Floppa | Floppa
    .desc = 他在這兒。 | He out here.
    .suffix = { ent-MobCatCaracal.suffix }
ent-MobBandito = Bandito | Bandito
    .desc = 只是個傻乎乎的小傢伙罷了！ | Just a silly little guy!
    .suffix = { ent-MobFerret.suffix }
ent-MobBingus = 賓古斯 | Bingus
    .desc = 我摯愛的賓古斯…… | Bingus my beloved...
