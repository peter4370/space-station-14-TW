    .desc = { ent-FoodEgg.desc }
    .suffix = Fertilized, Chicken
ent-BaseCockroach = { ent-SolutionFood }
    .desc = { ent-SolutionFood.desc }
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobCockroach = 蟑螂 | cockroach
    .desc = 這個太空站裡到處都是蟲子。 | This station is just crawling with bugs.
    .suffix = { ent-BaseCockroach.suffix }
ent-MobGlockroach = glockroach | glockroach
    .desc = 這站裡到處都是蟑螂——天啊！那隻蟑螂居然拿著槍！！！ | This station is just crawling with bu- OH GOD THAT COCKROACH HAS A GUN!!!
    .suffix = Admeme
ent-MobMothroach = 蛾蟑螂 | mothroach
    .desc = 這是多次嘗試將「蛾人」與蟑螂進行基因混種後，所產生的這隻可愛的副產品。 | This is the adorable by-product of multiple attempts at genetically mixing mothpeople with cockroaches.
    .suffix = { ent-BaseCockroach.suffix }
ent-MobDuckMallard = 綠頭鴨
    .desc = 一隻可愛的綠頭鴨，毛茸茸的，摸起來好柔軟！ | An adorable mallard duck, it's fluffy and soft!
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobDuckWhite = 白鴨
    .desc = 一隻可愛的白鴨子，毛茸茸的，摸起來好柔軟！ | An adorable white duck, it's fluffy and soft!
    .suffix = { ent-MobDuckMallard.suffix }
ent-MobDuckBrown = 褐鴨
    .desc = 一隻可愛的棕色小鴨，毛茸茸的，摸起來好柔軟！ | An adorable brown duck, it's fluffy and soft!
    .suffix = { ent-MobDuckMallard.suffix }
ent-FoodEggDuckFertilized = { ent-FoodEgg }
    .desc = { ent-FoodEgg.desc }
    .suffix = Fertilized, Duck
ent-MobButterfly = 蝴蝶 | butterfly
    .desc = 儘管普遍存在誤解，但它其實並非由奶油製成。 | Despite popular misconceptions, it's not actually made of butter.
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobCow = 牛 | cow
    .desc = 哞。 | Moo.
    .suffix = { ent-SimpleMobBase.suffix }
ent-SolutionUdder = { ent-SolutionLarge }
    .desc = { ent-SolutionLarge.desc }
ent-MobCrab = 螃蟹 | crab
    .desc = 民間流傳著一個傳說，說他的爪子會因太空人說了令人不快的話，而將他們從存在中撕碎。為了自身安全，請保持禮貌與寬容。 | A folk legend goes around that his claw snaps spacemen out of existence over distasteful remarks. Be polite and tolerant for your own safety.
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobGoat = 山羊 | goat
    .desc = 她的脊椎由一節節又長又尖的段落組成，難怪她總是這麼愛發牢騷。 | Her spine consists of long sharp segments, no wonder she is so grumpy.
    .suffix = { ent-SimpleMobBase.suffix }
ent-SolutionUdderGoat = { ent-SolutionUdder }
    .desc = { ent-SolutionUdder.desc }
ent-SolutionWool = { ent-SolutionLarge }
    .desc = { ent-SolutionLarge.desc }
ent-MobSheepBase = sheepBase | sheepBase
    .desc = 一隻羊。 | A sheep.
ent-SolutionUdderSheep = { ent-SolutionUdder }
    .desc = { ent-SolutionUdder.desc }
ent-SolutionWoolSheep = { ent-SolutionWool }
    .desc = { ent-SolutionWool.desc }
ent-SolutionWoolSheepRainbow = { ent-SolutionWool }
    .desc = { ent-SolutionWool.desc }
ent-MobSheep = 綿羊 | sheep
    .desc = 一座可愛的基因改造化學工廠，專門生產牛奶和棉花。 | An adorable genetically engineered chemical factory producing milk and cotton.
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobSheepRainbow = 彩虹綿羊 | rainbow sheep
    .desc = 一隻羊；這隻看起來……好像發著光。 | A sheep; this one seems... glowy.
    .suffix = { ent-MobSheep.suffix }
ent-MobGoose = 鵝 | goose
    .desc = 它的胃和心智，是人類無法理解的謎團。 | Its stomach and mind are an enigma beyond human comprehension.
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobGorilla = 大猩猩 | gorilla
    .desc = 猛砸、咆哮、看起來很酷。別站在它旁邊。 | Smashes, roars, looks cool. Don't stand near one.
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobKangaroo = 袋鼠 | kangaroo
    .desc = 一種大型的有袋類草食動物。牠擁有強壯的後腿，腳趾上的指甲形似長爪。 | A large marsupial herbivore. It has powerful hind legs, with nails that resemble long claws.
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobBoxingKangaroo = 拳擊袋鼠 | boxing kangaroo
    .desc = { ent-MobKangaroo.desc }
    .suffix = { ent-MobKangaroo.suffix }
ent-MobBaseAncestor = 遺傳祖先 | genetic ancestor
    .desc = 某種……呃……生物的遺傳學上的直立行走祖先。沒錯，太空站裡肯定有某種生物，是從這東西演化而來的。 | The genetic bipedal ancestor of... Uh... Something. Yeah, there's definitely something on the station that descended from whatever this is.
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobMonkey = 猴子 | monkey
    .desc = 新達爾文主義者的「新教派」確實相信，所有動物都是從猴子演化而來的。吃起來像豬肉，殺牠們既有趣又讓人放鬆。 | New church of neo-darwinists actually believe that EVERY animal evolved from a monkey. Tastes like pork, and killing them is both fun and relaxing.
    .suffix = { ent-MobBaseAncestor.suffix }
ent-MobBaseSyndicateMonkey = 猴子 | monkey
    .desc = 新達爾文主義者的「新教派」確實相信，所有動物都是從猴子演化而來的。吃起來像豬肉，殺牠們既有趣又讓人放鬆。 | New church of neo-darwinists actually believe that EVERY animal evolved from a monkey. Tastes like pork, and killing them is both fun and relaxing.
    .suffix = syndicate base
ent-MobMonkeySyndicateAgent = { ent-MobBaseSyndicateMonkey }
    .desc = { ent-MobBaseSyndicateMonkey.desc }
    .suffix = syndicate agent
ent-MobMonkeySyndicateAgentNukeops = { ent-MobBaseSyndicateMonkey }
    .desc = { ent-MobBaseSyndicateMonkey.desc }
    .suffix = NukeOps
ent-MobBaseKobold = 科博爾德 | kobold
    .desc = 作為具有智慧的蜥蜴人種族的近親，科博爾德能完美融入自然棲息地，性情卻如猴子般惡劣；隨時準備扯掉你的頭髮，並用刀將你刺死。 | Cousins to the sentient race of lizard people, kobolds blend in with their natural habitat and are as nasty as monkeys; ready to pull out your hair and stab you to death.
    .suffix = { ent-MobBaseAncestor.suffix }
ent-MobKobold = 科博爾德 | kobold
    .desc = 作為具有智慧的蜥蜴人種族的近親，科博爾德能完美融入自然棲息地，性情卻如猴子般惡劣；隨時準備扯掉你的頭髮，並用刀將你刺死。 | Cousins to the sentient race of lizard people, kobolds blend in with their natural habitat and are as nasty as monkeys; ready to pull out your hair and stab you to death.
    .suffix = { ent-MobBaseKobold.suffix }
ent-MobBaseSyndicateKobold = { ent-MobBaseKobold }
    .desc = { ent-MobBaseKobold.desc }
    .suffix = syndicate base
