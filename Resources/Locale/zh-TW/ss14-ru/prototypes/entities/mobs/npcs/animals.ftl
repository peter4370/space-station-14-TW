ent-MobBat = 蝙蝠 | bat
    .desc = 有些文化認為它們令人毛骨悚然，另一些文化則覺得它們咬起來很脆。 | Some cultures find them terrifying, others crunchy on the teeth.
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobBee = 蜜蜂 | bee
    .desc = 這固然是件好事，但僅靠蜂蜜是無法建立文明的。 | Nice to have, but you can't build a civilization on a foundation of honey alone.
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobAngryBee = 蜜蜂 | bee
    .desc = 這隻蜜蜂真可愛。哎呀，它看起來很生氣，好像想搶我的披薩。 | How nice a bee. Oh no, it looks angry and wants my pizza.
    .suffix = Angry
ent-MobChicken = 雞 | chicken
    .desc = 比雞蛋還早出現，而且本身就是一隻恐龍！ | Comes before an egg, and IS a dinosaur!
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobChicken1 = { ent-MobChicken }
    .desc = { ent-MobChicken.desc }
    .suffix = { ent-MobChicken.suffix }
ent-MobChicken2 = { ent-MobChicken }
    .desc = { ent-MobChicken.desc }
    .suffix = { ent-MobChicken.suffix }
