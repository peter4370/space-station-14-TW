    .suffix = { ent-MobSpiderAngryBase.suffix }
ent-MobGiantSpiderWizard = 巫師蜘蛛 | wizard spider
    .desc = 這隻蜘蛛看起來有點神奇 | This spider looks a little magical
    .suffix = Wizard
ent-MobPossum = 負鼠 | possum
    .desc = 「噢，負鼠！我的負鼠！」——華特·惠特曼，1865年 | "O Possum! My Possum!" -- Walt Whitman, 1865
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobPossumOld = 負鼠 | possum
    .desc = { ent-MobPossum.desc }
    .suffix = Old sprite
ent-MobRaccoon = 浣熊 | raccoon
    .desc = 垃圾熊！ | Trash panda!
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobFox = 狐狸 | fox
    .desc = 牠們是隻狐狸。 | They're a fox.
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobCorgiBase = 柯基犬 | corgi
    .desc = 終於有太空柯基了！ | Finally, a space corgi!
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobCorgi = { ent-MobCorgiBase }
    .desc = { ent-MobCorgiBase.desc }
    .suffix = { ent-MobCorgiBase.suffix }
ent-MobCorgiNarsi = 墮落的柯基犬 | corrupted corgi
    .desc = 伊恩！不要！ | Ian! No!
    .suffix = { ent-MobCorgi.suffix }
ent-MobCorgiPuppy = 柯基幼犬 | corgi puppy
    .desc = 一隻小柯基！哇…… | A little corgi! Aww...
    .suffix = { ent-MobCorgi.suffix }
ent-MobCat = 貓 | cat
    .desc = 這隻貓咪，真是太有趣了。 | Feline pet, very funny.
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobCatCalico = 三色貓 | calico cat
    .desc = 這隻貓咪，真是太有趣了。 | Feline pet, very funny.
    .suffix = { ent-MobCat.suffix }
ent-MobCatSyndy = 工會 | syndicat
    .desc = 爆笑小貓。 | Explosive kitten.
    .suffix = { ent-MobCatSpace.suffix }
ent-MobCatSpace = 太空貓 | space cat
    .desc = 這隻貓咪，已做好最壞的打算。 | Feline pet, prepared for the worst.
    .suffix = { ent-MobCat.suffix }
ent-MobCatCaracal = 卡拉卡爾貓 | caracal cat
    .desc = 太好笑了。 | Hilarious.
    .suffix = { ent-MobCat.suffix }
ent-MobCatKitten = 小貓 | kitten
    .desc = 小巧又蓬鬆。 | Small and fluffy.
    .suffix = { ent-MobCat.suffix }
ent-MobSloth = 樹懶 | sloth
    .desc = 動作非常緩慢的動物。適合精力較少的人。 | Very slow animal. For people with low energy.
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobFerret = 雪貂 | ferret
    .desc = 只是個傻乎乎的小傢伙罷了！ | Just a silly little guy!
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobHamster = 倉鼠 | hamster
    .desc = 一隻可愛、毛茸茸又健壯的倉鼠。 | A cute, fluffy, robust hamster.
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobPig = 豬 | pig
    .desc = 嗷嗷。 | Oink.
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobDionaNymph = 迪奧娜·尼姆芙 | diona nymph
    .desc = 它就像一隻貓，只是……枝葉更茂盛一些。 | It's like a cat, only.... branch-ier.
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobDionaNymphAccent = { ent-MobDionaNymph }
    .desc = { ent-MobDionaNymph.desc }
    .suffix = Accent
ent-MobReindeerBuck = 雄馴鹿 | reindeer buck
    .desc = 你覺得它能拉雪橇嗎？ | You think it can pull a sleigh?
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobReindeerDoe = 雌馴鹿 | reindeer doe
    .desc = { ent-MobReindeerBuck.desc }
    .suffix = { ent-MobReindeerBuck.suffix }
