execution-verb-name = 執行
execution-verb-message = 使用你的武器處決某人。

# All the below localisation strings have access to the following variables
# attacker (the person committing the execution)
# victim (the person being executed)
# weapon (the weapon used for the execution)

execution-popup-melee-initial-internal = 你準備好將 { THE($weapon) } 抵住 { THE($victim) } 的喉嚨了嗎？
execution-popup-melee-initial-external = { CAPITALIZE(THE($attacker)) } 將 { POSS-ADJ($attacker) } { $weapon } 抵在 { THE($victim) } 的喉嚨上。
execution-popup-melee-complete-internal = 你割斷了 { THE($victim) } 的喉嚨！
execution-popup-melee-complete-external = { CAPITALIZE(THE($attacker)) } 割斷了 { THE($victim) } 的喉嚨！
execution-popup-self-initial-internal = 你準備好將 { THE($weapon) } 抵住自己的喉嚨了嗎？
execution-popup-self-initial-external = { CAPITALIZE(THE($attacker)) } 將 { POSS-ADJ($attacker) } { $weapon } 對準他們自己的喉嚨。
execution-popup-self-complete-internal = 是你自己割斷了自己的喉嚨！
execution-popup-self-complete-external = { CAPITALIZE(THE($attacker)) } 簡直是自斷喉嚨！
